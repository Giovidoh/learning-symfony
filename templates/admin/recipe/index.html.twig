{% extends 'admin/admin.html.twig' %}

{% block title "Toutes les recettes" %}

{% block body %}
    <div class="mb-4">
        <a class="theme-primary btn-solid btn-styled btn-sm" href="{{ path('admin.recipe.create') }}">Créer une recette</a>
    </div>

    <div id="flash"></div>

    <table class="table">
        <thead>
            <tr>
                <th>{{ knp_pagination_sortable(recipes, 'ID', 'r.id') }}</th>
                <th>{{ knp_pagination_sortable(recipes, 'Titre', 'r.title') }}</th>
                <th>Catégorie</th>
                <th style="width: 200px">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for recipe in recipes %}
                <tr id="row_recipe_{{ recipe.id }}">
                    <td>{{ recipe.id }}</td>
                    <td>
                        <turbo-frame id="recipe_{{ recipe.id }}">
                            <a href="{{ path('admin.recipe.edit', {id: recipe.id}) }}">{{ recipe.title }}</a>
                        </turbo-frame>
                    </td>
                    <td>{{ recipe.category.name|default('') }}</td>
                    <td>
                        {% if is_granted('RECIPE_EDIT', recipe) %}
                            <div class="d-flex gap-2">
                                <a class="theme-primary btn-solid btn-styled btn-sm" href="{{ path('admin.recipe.edit', {id: recipe.id}) }}">Éditer</a>
                                <form action="{{ path('admin.recipe.delete', {id: recipe.id}) }}" method="post">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <button class="theme-danger btn-solid btn-styled btn-sm">Supprimer</button>
                                </form>
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {{ knp_pagination_render(recipes) }}
{% endblock %}
